{
  "aioVersion": "v1.0.19-beta",
  "name": "llama-master",
  "title": "llama.master",
  "version": "0.13.0",
  "exports": "./src/app.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "aio"
  },
  "imports": {
    "aio": "./dep/aio/mod.ts",
    "aio/air": "./dep/aio/src/air.ts",
    "aio/jsx-runtime": "./dep/aio/src/jsx-runtime.ts",
    "aio/testing": "./dep/aio/src/cell-test.ts",
    "aio/server": "./dep/aio/src/server-entry.ts",
    "aio/schedule": "./dep/aio/src/schedule.ts",
    "aio/build": "./dep/aio/src/build.ts",
    "aio/am": "./dep/aio/src/am.ts",
    "aio/doctor": "./dep/aio/src/server/doctor.ts",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.3",
    "electron": "npm:electron@44.5.1",
    "esbuild": "npm:esbuild@0.25.12",
    "happy-dom": "npm:happy-dom@20.14.5",
    "immer": "npm:immer@10.2.0"
  },
  "tasks": {
    "dev": "deno run -A src/app.ts",
    "wasm": "deno run -A scripts/wasm.ts",
    "test": "deno test -A tests/",
    "test:rust": "cargo test --quiet --manifest-path rust/Cargo.toml",
    "check": "deno check src/ tests/ scripts/",
    "lint": "deno lint src/ tests/ scripts/",
    "fmt": "deno fmt src/ tests/ scripts/",
    "aiol": "deno run -A dep/aio/aiol/mod.ts .",
    "am": "deno run -A dep/aio/src/am.ts",
    "doctor": "deno run -A dep/aio/src/server/doctor.ts",
    "install:electron": "deno install --allow-scripts=npm:electron",
    "compile": "deno run -A dep/aio/src/build.ts --compile",
    "compile:electron": "deno run -A dep/aio/src/build.ts --compile --electron",
    "verify": "deno fmt --check src/ tests/ scripts/ && deno lint src/ tests/ scripts/ && deno check src/ tests/ scripts/ && deno test -A tests/",
    "build": "deno run -A ./dep/aio/src/build-all.ts --build-spec=./dep/aio/src/build.ts",
    "publish": "deno run -A ./dep/aio/src/am.ts publish",
    "ship": "deno run -A ./dep/aio/src/build/ship.ts"
  },
  "fmt": {
    "exclude": [
      "dep/",
      "dist/",
      "rust/target/",
      "node_modules/"
    ]
  },
  "lint": {
    "exclude": [
      "dep/",
      "dist/",
      "rust/",
      "node_modules/"
    ]
  },
  "build": {
    "targets": [
      "browser",
      "electron"
    ]
  }
}
